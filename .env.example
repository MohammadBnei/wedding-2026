# Pigsty. Port 5432, NOT 6432 — pgbouncer's transaction pooling breaks
# prepared statements. In the cluster these come from Infisical.
WEDDING_DB_HOST=postgres.bnei.lan
WEDDING_DB_PORT=5432
WEDDING_DB_NAME=weddingdb
WEDDING_DB_USER=dbuser_wedding
WEDDING_DB_PASSWORD=

# Any OpenAI-compatible endpoint. Leave OPENAI_API_KEY unset and the chatbot
# degrades to the canned FAQ answers — the site still works, nothing crashes.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini

# Phone numbers, kept out of this repo because it is public. Unset means the
# contact block does not render and the bot will not invent a number.

WEDDING_CONTACT_LINE=

# Shared album guests drop photos into. Empty hides the link and the bot won't
# mention one. Env-driven so it can change after the day without a rebuild.
PHOTO_DROP_URL=
