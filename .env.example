# Copy to .env for local development. .env is gitignored; nothing here is secret.
#
# The database below is the one compose.yaml brings up:
#   docker compose up -d --wait
#   bun run dev
#
# In the cluster none of this comes from a file — Infisical injects WEDDING_DB_*
# and OPENAI_* into the pod (project wedding-2026-ih1x, see helm/values.yaml).
WEDDING_DB_HOST=localhost
WEDDING_DB_PORT=55432
WEDDING_DB_NAME=weddingdb
WEDDING_DB_USER=postgres
WEDDING_DB_PASSWORD=postgres

# Any OpenAI-compatible endpoint. Leave OPENAI_API_KEY unset and the chatbot
# degrades to the canned FAQ answers — the site still works, nothing crashes.
# To exercise the real bot locally, either paste a key into .env or start the
# dev server under Infisical:
#
#   infisical run --projectId=798540d3-0c3e-47ee-b447-468d65088377 --env=dev -- \
#     env WEDDING_DB_HOST=localhost WEDDING_DB_PORT=55432 bun run dev
#
# The `env` AFTER `--` is not decoration: `infisical run` injects its own values
# over the parent environment, so exporting WEDDING_DB_HOST beforehand is
# silently overridden by postgres.bnei.lan, which does not resolve off-LAN.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini

# Shared album guests drop photos into. Empty hides the link and the bot won't
# mention one. Env-driven so it can change after the day without a rebuild.
PHOTO_DROP_URL=

# ORIGIN is production-only and lives in helm/values.yaml, not here: vite serves
# dev, adapter-node only reads it in the built container. Without it behind
# Traefik every RSVP is rejected as a cross-site POST.

# --- The guest wall ---------------------------------------------------------
# Object storage for wall photos. LEAVE S3_ENDPOINT EMPTY locally: s3.js then
# writes to ./.s3-dev instead of Garage, so `bun run dev` and the e2e tests need
# no extra container and compose.yaml stays "the local Postgres, and nothing
# else". garage.bnei.lan does not resolve off-LAN anyway.
S3_ENDPOINT=
S3_BUCKET=wedding-wall
# Bun signs SigV4 with region "auto" unless told otherwise, and Garage rejects
# anything but its configured region. Only matters when S3_ENDPOINT is set.
S3_REGION=garage
WEDDING_WALL_S3_ACCESS_KEY=
WEDDING_WALL_S3_SECRET=

# The kill switch. Set to "false" in Infisical (autoReload is on, so the pod
# restarts and picks it up without a rebuild or a deploy) to close the wall to
# new posts while leaving everything already approved cycling on the projector.
WALL_ENABLED=true

# Screening. Falls back to OPENAI_MODEL. Must be able to SEE images — a
# text-only model does not fail loudly, it ignores the image and approves it.
# Verified against the live endpoint by sending two solid colours and checking
# it can tell them apart.
OPENAI_MODERATION_MODEL=
